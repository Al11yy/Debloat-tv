<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212">

    <!-- ==================== LEGACY COMPATIBILITY STUBS (NON-NULL) ==================== -->
    <com.gathin.tvhome.SkyView android:id="@+id/sky" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageView android:id="@+id/heroArt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/ambient" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/heroScrim" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/hero" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <TextView android:id="@+id/heroName" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/heroMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/heroDots" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/racePanel" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <TextView android:id="@+id/raceKicker" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/raceHeadline" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/raceSessions" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout android:id="@+id/leftBlock" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/shamsiDate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/stats" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/topButtons" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
        <TextView android:id="@+id/btnReorder" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/btnLibraryTop" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <com.gathin.tvhome.GlassView android:id="@+id/glass" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ==================== NOTHING (TV) HOME LAYOUT (PAGE 01) ==================== -->
    <LinearLayout
        android:id="@+id/nothingHomeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 1. GLOBAL HEADER BAR -->
        <RelativeLayout
            android:id="@+id/navHeader"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Branding -->
            <com.gathin.tvhome.NdotTextView
                android:id="@+id/brandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <!-- Navigation Tabs -->
            <LinearLayout
                android:id="@+id/navTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/brandTitle"
                android:layout_marginStart="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tabHome"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:background="@drawable/nothing_pill_bg"
                    android:text="Home"
                    android:textColor="@color/nothing_pill_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tabApps"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:background="@drawable/nothing_pill_bg"
                    android:text="Apps"
                    android:textColor="@color/nothing_pill_text"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tabLiveTv"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:background="@drawable/nothing_pill_bg"
                    android:text="Live TV"
                    android:textColor="@color/nothing_pill_text"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/tabMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:background="@drawable/nothing_pill_bg"
                    android:text="Media"
                    android:textColor="@color/nothing_pill_text"
                    android:textSize="14sp"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- Utility Action Icons & Profile -->
            <LinearLayout
                android:id="@+id/headerActions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnSearch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="7dp"
                    android:background="@drawable/nothing_pill_bg"
                    android:src="@drawable/ic_search"
                    android:focusable="true"
                    android:clickable="true" />

                <ImageView
                    android:id="@+id/btnInputs"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:padding="7dp"
                    android:background="@drawable/nothing_pill_bg"
                    android:src="@drawable/ic_input"
                    android:focusable="true"
                    android:clickable="true" />

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:padding="7dp"
                    android:background="@drawable/nothing_pill_bg"
                    android:src="@drawable/ic_settings"
                    android:focusable="true"
                    android:clickable="true" />

                <!-- Profile avatar -->
                <TextView
                    android:id="@+id/btnProfile"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:background="@drawable/nothing_avatar_bg"
                    android:text="F"
                    android:textColor="@color/nothing_avatar_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <!-- Keep btnWifi present for ConnectivityManager callback -->
                <TextView
                    android:id="@+id/btnWifi"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 2. WIDGETS ROW -->
        <LinearLayout
            android:id="@+id/widgetsRow"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Analog Clock Card -->
            <com.gathin.tvhome.AnalogClockCardView
                android:id="@+id/widgetClock"
                android:layout_width="160dp"
                android:layout_height="165dp"
                android:focusable="true"
                android:clickable="true" />

            <!-- Date Card -->
            <com.gathin.tvhome.DateCardView
                android:id="@+id/widgetDate"
                android:layout_width="135dp"
                android:layout_height="165dp"
                android:layout_marginStart="14dp"
                android:focusable="true"
                android:clickable="true" />

            <!-- Prayer Times Card -->
            <com.gathin.tvhome.PrayerTimesCardView
                android:id="@+id/widgetPrayer"
                android:layout_width="0dp"
                android:layout_height="165dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:focusable="true"
                android:clickable="true" />

            <!-- Status Card (HDMI 1, Wi-Fi, Sleep) -->
            <com.gathin.tvhome.StatusCardView
                android:id="@+id/widgetStatus"
                android:layout_width="180dp"
                android:layout_height="165dp"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- 3. "YOUR APPS" ROW -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <com.gathin.tvhome.NdotTextView
                android:id="@+id/yourAppsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Hold OK to arrange"
                android:textColor="#666666"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- Horizontal scrollable app list -->
        <HorizontalScrollView
            android:id="@+id/appsScrollView"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/appsRowContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </HorizontalScrollView>

        <!-- 4. BOTTOM ACTION PILLS -->
        <LinearLayout
            android:id="@+id/bottomPills"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pillLiveTv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/nothing_pill_bg"
                android:drawableStart="@drawable/ic_livetv"
                android:drawablePadding="8dp"
                android:text="Live TV"
                android:textColor="@color/nothing_pill_text"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillMedia"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/nothing_pill_bg"
                android:drawableStart="@drawable/ic_media"
                android:drawablePadding="8dp"
                android:text="Media library"
                android:textColor="@color/nothing_pill_text"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillCustomize"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/nothing_pill_bg"
                android:drawableStart="@drawable/ic_tune"
                android:drawablePadding="8dp"
                android:text="Customize"
                android:textColor="@color/nothing_pill_text"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillQuickSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/nothing_pill_bg"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="8dp"
                android:text="Quick settings"
                android:textColor="@color/nothing_pill_text"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- 5. FOOTER BAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="D-PAD Navigate   OK Select   BACK Return"
                android:textColor="#666666"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="01 / HOME"
                android:textColor="#666666"
                android:textSize="11sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Page 02: ALL APPS -->
    <com.gathin.tvhome.AllAppsPageView
        android:id="@+id/pageAllApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Page 04: SEARCH -->
    <com.gathin.tvhome.SearchPageView
        android:id="@+id/pageSearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Page 05: INPUTS -->
    <com.gathin.tvhome.InputsPageView
        android:id="@+id/pageInputs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Page 06: QUICK SETTINGS -->
    <com.gathin.tvhome.QuickSettingsPageView
        android:id="@+id/pageQuickSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Page 07: SETTINGS HUB -->
    <com.gathin.tvhome.SettingsHubPageView
        android:id="@+id/pageSettingsHub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Page 08: PRAYER DETAILS -->
    <com.gathin.tvhome.PrayerDetailsPageView
        android:id="@+id/pagePrayerDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Page 03: APP OPTIONS OVERLAY -->
    <com.gathin.tvhome.AppOptionsOverlayView
        android:id="@+id/pageAppOptions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
